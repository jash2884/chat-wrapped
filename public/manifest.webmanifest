{
  "id": "/",
  "name": "Chat Wrapped",
  "short_name": "Wrapped",
  "description": "Spotify Wrapped for your WhatsApp and Telegram chats, analysed on your device.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0d0a17",
  "theme_color": "#0d0a17",
  "categories": ["entertainment", "social", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "chat",
          "accept": ["text/plain", ".txt", "application/zip", "application/x-zip-compressed", ".zip", "application/json", ".json"]
        }
      ]
    }
  }
}
