{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-wrapped",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "wrapped.jashparmar.com", "custom_domain": true }],
  "workers_dev": false,
  "vars": { "GEMINI_MODEL": "gemini-2.5-flash" },
  // Per-IP limit on the AI endpoint; the result is also edge-cached by payload hash.
  "ratelimits": [{ "name": "AI_LIMITER", "namespace_id": "4201", "simple": { "limit": 6, "period": 60 } }],
  "observability": { "enabled": true }
}
